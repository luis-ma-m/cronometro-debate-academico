# Optional. In production the frontend uses the same-origin /api endpoint by default.
# VITE_API_URL=

# The only backend variables required in Vercel are:
# ADMIN_PASSWORD
# GOOGLE_SERVICE_ACCOUNT_JSON
# UPSTASH_REDIS_REST_URL
# UPSTASH_REDIS_REST_TOKEN
# Keep all four private. Never use a VITE_ prefix for secrets.
# See docs/DEPLOYMENT.md. Google Apps Script is no longer used.
