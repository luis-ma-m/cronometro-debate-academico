# Optional. In production the frontend uses the same-origin /api endpoint by default.
# VITE_API_URL=

# Private backend variables required in Vercel:
# NEON_DATABASE_URL (or DATABASE_URL)
# ADMIN_PASSWORD
# UPSTASH_REDIS_REST_URL
# UPSTASH_REDIS_REST_TOKEN
# Keep all backend secrets private. Never use a VITE_ prefix for secrets.
# See docs/DEPLOYMENT.md and docs/NEON_MIGRATION.md.
